{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Assemble Ultimate debug",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "--no-daemon",
                "--console=plain",
                ":app:assembleUltimateDebug"
            ],
            "problemMatcher": ["$gradle"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Test Ultimate debug",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "--no-daemon",
                "--console=plain",
                ":app:testUltimateDebugUnitTest"
            ],
            "problemMatcher": ["$gradle"],
            "group": "test"
        },
        {
            "label": "Lint Ultimate debug",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "--no-daemon",
                "--console=plain",
                ":app:lintUltimateDebug"
            ],
            "problemMatcher": ["$gradle"],
            "group": "test"
        }
    ]
}
