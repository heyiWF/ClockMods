{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClockMods",
  "version": "0.1.0",
  "identifier": "com.clockmods.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClockMods",
        "width": 1100,
        "height": 740,
        "minWidth": 320,
        "minHeight": 320,
        "backgroundColor": "#101923"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Customizable desktop clock, calendar and timers",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
