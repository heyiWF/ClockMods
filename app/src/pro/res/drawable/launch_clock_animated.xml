<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/launch_clock">
    <target android:name="sector"><aapt:attr name="android:animation"><set android:ordering="together">
        <objectAnimator android:propertyName="translateX" android:valueFrom="11" android:valueTo="0" android:valueType="floatType" android:startOffset="80" android:duration="840" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <objectAnimator android:propertyName="translateY" android:valueFrom="-13" android:valueTo="0" android:valueType="floatType" android:startOffset="80" android:duration="840" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </set></aapt:attr></target>
    <target android:name="sectorFill"><aapt:attr name="android:animation"><objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:startOffset="80" android:duration="660" android:interpolator="@android:interpolator/fast_out_slow_in" /></aapt:attr></target>
    <target android:name="sectorHighlight"><aapt:attr name="android:animation"><objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:startOffset="80" android:duration="660" android:interpolator="@android:interpolator/fast_out_slow_in" /></aapt:attr></target>
</animated-vector>
