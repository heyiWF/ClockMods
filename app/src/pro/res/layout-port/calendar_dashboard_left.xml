<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/calendar_clock_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.98"
        android:background="@drawable/calendar_dashboard_panel"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <com.clockmods.ui.StatusBarView
            android:id="@+id/calendar_status_bar"
            android:layout_width="170dp"
            android:layout_height="28dp"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.clockmods.ui.ClockTextView
                    android:id="@+id/calendar_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_text"
                    android:textSize="@dimen/calendar_dashboard_time_size_port"
                    android:textStyle="bold" />

                <com.clockmods.ui.ClockTextView
                    android:id="@+id/calendar_seconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/calendar_time"
                    android:layout_toEndOf="@id/calendar_time"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_blue"
                    android:textSize="@dimen/calendar_dashboard_seconds_size_port"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calendar_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/calendar_seconds"
                    android:layout_alignStart="@id/calendar_seconds"
                    android:layout_marginBottom="@dimen/calendar_period_gap"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_secondary"
                    android:textSize="@dimen/calendar_dashboard_period_size_port"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_current_weather_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/calendar_dashboard_gutter"
        android:layout_weight="0.89"
        android:background="@drawable/calendar_dashboard_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <com.clockmods.ui.WeatherIconView
            android:id="@+id/calendar_current_weather_icon"
            android:layout_width="0dp"
            android:layout_height="@dimen/calendar_dashboard_weather_icon_size_port"
            android:layout_weight="0.8"
            android:translationX="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:gravity="center"
            android:orientation="vertical"
            android:translationX="-6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_horizontal|bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/calendar_current_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:autoSizeMaxTextSize="@dimen/calendar_dashboard_temperature_size_port"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/calendar_dashboard_text"
                    android:textSize="@dimen/calendar_dashboard_temperature_size_port"
                    android:textStyle="bold"
                    android:translationY="5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/calendar_feels_like_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/calendar_dashboard_feels_label_size_port"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/calendar_feels_like"
                        android:textColor="@color/calendar_dashboard_secondary"
                        android:textSize="@dimen/calendar_dashboard_feels_label_size_port" />

                    <TextView
                        android:id="@+id/calendar_feels_like"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/calendar_dashboard_feels_size_port"
                        android:autoSizeMinTextSize="22sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/calendar_dashboard_blue"
                        android:textSize="@dimen/calendar_dashboard_feels_size_port" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/calendar_weather_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="@dimen/calendar_dashboard_weather_summary_size_port"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAlignment="center"
                android:textColor="@color/calendar_dashboard_text"
                android:textSize="@dimen/calendar_dashboard_weather_summary_size_port" />
        </LinearLayout>

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/calendar_weather_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_forecast_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/calendar_dashboard_gutter"
        android:layout_weight="0.98"
        android:background="@drawable/calendar_dashboard_panel"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/calendar_forecast_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/calendar_forecast_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/calendar_forecast_after_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/calendar_forecast_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <include
        layout="@layout/calendar_weather_attribution"
        android:layout_width="match_parent"
        android:layout_height="24dp" />
</LinearLayout>
