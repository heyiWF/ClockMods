<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/calendar_dashboard_time_height"
        android:background="@drawable/calendar_dashboard_panel"
        android:padding="14dp">

        <com.clockmods.ui.StatusBarView
            android:id="@+id/calendar_status_bar"
            android:layout_width="150dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="-3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="20dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.clockmods.ui.ClockTextView
                    android:id="@+id/calendar_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_text"
                    android:textSize="@dimen/calendar_dashboard_time_size"
                    android:textStyle="bold" />

                <com.clockmods.ui.ClockTextView
                    android:id="@+id/calendar_seconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/calendar_time"
                    android:layout_toEndOf="@id/calendar_time"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_blue"
                    android:textSize="@dimen/calendar_dashboard_seconds_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calendar_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/calendar_seconds"
                    android:layout_alignStart="@id/calendar_seconds"
                    android:layout_marginBottom="@dimen/calendar_period_gap"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_secondary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/calendar_current_weather_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/calendar_dashboard_weather_height"
        android:layout_marginTop="@dimen/calendar_dashboard_gutter"
        android:background="@drawable/calendar_dashboard_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.clockmods.ui.WeatherIconView
                android:id="@+id/calendar_current_weather_icon"
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <TextView
                android:id="@+id/calendar_current_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:includeFontPadding="false"
                android:textColor="@color/calendar_dashboard_text"
                android:textSize="@dimen/calendar_dashboard_temperature_size"
                android:textStyle="bold"
                android:translationY="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/calendar_feels_like"
                    android:textColor="@color/calendar_dashboard_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/calendar_feels_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/calendar_dashboard_blue"
                    android:textSize="38sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/calendar_weather_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAlignment="center"
            android:textColor="@color/calendar_dashboard_text"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_forecast_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/calendar_dashboard_forecast_height"
        android:layout_marginTop="@dimen/calendar_dashboard_gutter"
        android:background="@drawable/calendar_dashboard_panel"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/calendar_forecast_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/calendar_forecast_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/calendar_forecast_after_tomorrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical" />
    </LinearLayout>

    <include layout="@layout/calendar_weather_attribution" />
</LinearLayout>
