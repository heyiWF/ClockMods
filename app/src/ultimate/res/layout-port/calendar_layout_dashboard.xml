<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_dashboard_background"
    android:orientation="vertical"
    android:padding="@dimen/calendar_dashboard_gutter">

    <FrameLayout
        android:id="@+id/calendar_left_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.46">
        <include layout="@layout/calendar_dashboard_left" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/calendar_month_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/calendar_dashboard_gutter"
        android:layout_weight="0.54">
        <include layout="@layout/calendar_dashboard_month" />
    </FrameLayout>
</LinearLayout>
