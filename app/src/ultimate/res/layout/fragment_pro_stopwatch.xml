<?xml version="1.0" encoding="utf-8"?>
<com.clockmods.pro.ToolWorkspaceLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pro_page_stopwatch" android:textAppearance="?attr/textAppearanceHeadlineMedium"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/stopwatch_display" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:fontFamily="sans-serif-light" android:maxLines="1" android:text="00:00.00" android:textColor="?attr/colorOnSurface"
        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="24sp" app:autoSizeMaxTextSize="96sp" app:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/stopwatch_records" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginBottom="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="12dp">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/stopwatch_lap" android:textAppearance="?attr/textAppearanceLabelMedium"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/stopwatch_split" android:textAppearance="?attr/textAppearanceLabelMedium"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/stopwatch_total" android:textAppearance="?attr/textAppearanceLabelMedium"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/stopwatch_laps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </ScrollView></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
        android:id="@+id/stopwatch_reset" style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp" android:layout_height="72dp"
         android:layout_marginHorizontal="4dp"
        android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp"
        android:paddingHorizontal="12dp" app:cornerRadius="36dp"
        android:contentDescription="@string/timer_reset"
        android:textSize="20sp" app:icon="@drawable/tool_ic_reset" app:iconSize="28dp"
        app:iconGravity="textStart" app:iconPadding="0dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/stopwatch_start_pause" style="@style/Widget.Material3.Button"
        android:layout_width="0dp" android:layout_height="72dp"
        android:layout_weight="1" android:layout_marginHorizontal="4dp"
        android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp"
        android:paddingHorizontal="12dp" app:cornerRadius="36dp"
        android:contentDescription="@string/timer_start" android:text="@string/timer_start"
        android:textSize="20sp" app:icon="@drawable/tool_ic_play" app:iconSize="28dp"
        app:iconGravity="textStart" app:iconPadding="8dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/stopwatch_lap" style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp" android:layout_height="72dp"
         android:layout_marginHorizontal="4dp"
        android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp"
        android:paddingHorizontal="12dp" app:cornerRadius="36dp"
        android:contentDescription="@string/stopwatch_lap"
        android:textSize="20sp" app:icon="@drawable/tool_ic_flag" app:iconSize="28dp"
        app:iconGravity="textStart" app:iconPadding="0dp" />
        </LinearLayout>
    </LinearLayout>
</com.clockmods.pro.ToolWorkspaceLayout>
