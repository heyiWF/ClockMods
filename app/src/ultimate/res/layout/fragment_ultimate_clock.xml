<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.clockmods.ultimate.clock.UltimateClockView
        android:id="@+id/ultimate_clock_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes" />

    <com.clockmods.ui.ClockView
        android:id="@+id/pro_classic_clock_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <com.clockmods.ui.StatusBarView
        android:id="@+id/status_bar_view"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/ultimate_overlay_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/weather_attribution"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/weather_attribution"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_attribution_prefix"
            android:textColor="#66FFFFFF"
            android:textSize="7sp" />

        <com.clockmods.ui.QWeatherLogoView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:alpha="0.45" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_attribution_brand"
            android:textColor="#66FFFFFF"
            android:textSize="7sp" />
    </LinearLayout>
</FrameLayout>
