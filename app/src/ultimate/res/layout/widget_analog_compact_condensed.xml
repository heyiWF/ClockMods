<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/Theme.ClockMods.Widget.Dynamic">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg_instrument" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="@dimen/widget_inset_start_compact" android:paddingEnd="@dimen/widget_inset_end_compact" android:paddingTop="@dimen/widget_inset_top_compact" android:paddingBottom="@dimen/widget_inset_bottom_compact"><AnalogClock android:id="@+id/widget_analog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:dial="@drawable/widget_analog_0_dial" android:hand_hour="@drawable/widget_analog_0_hour" android:hand_minute="@drawable/widget_analog_0_minute" android:hand_second="@null"/><TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/widget_date"/><TextView android:id="@+id/widget_lunar" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /><TextView android:id="@+id/widget_holiday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /><TextView android:id="@+id/widget_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /></LinearLayout>
<ImageView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:padding="14dp" android:src="@drawable/widget_settings" android:contentDescription="@string/widget_configure"/>
</FrameLayout>
