<?xml version="1.0" encoding="utf-8"?>
<!--
  The calendar page owns no composition of its own any more: the selected CalendarStyle inflates
  its own layout into this host. Keep this file free of ids the styles rely on — anything a style
  needs belongs in that style's calendar_layout_*.xml, including its orientation variants.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_style_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
