<?xml version="1.0" encoding="utf-8"?>
<!--
  The poster style, portrait. A masthead of type over a bare number grid, with nothing between them
  but a hairline. There are no cards, so no panel background and no gutter: the page padding is the
  whole composition's margin.
-->
<com.clockmods.pro.MonthGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_month_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="20dp"
    android:paddingEnd="26dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:id="@+id/calendar_poster_masthead"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30">

        <com.clockmods.pro.CalendarWordmarkView
            android:id="@+id/calendar_poster_wordmark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />

        <TextView
            android:id="@+id/calendar_poster_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:minWidth="52dp"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/calendar_today"
            android:textSize="11sp" />
    </FrameLayout>

    <View
        android:id="@+id/calendar_poster_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp" />

    <GridLayout
        android:id="@+id/calendar_weekdays"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:columnCount="7"
        android:rowCount="1" />

    <FrameLayout
        android:id="@+id/calendar_grid_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70"
        android:clipChildren="true">

        <GridLayout
            android:id="@+id/calendar_grid_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="7"
            android:importantForAccessibility="noHideDescendants"
            android:rowCount="6"
            android:visibility="invisible" />

        <GridLayout
            android:id="@+id/calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="7"
            android:rowCount="6" />
    </FrameLayout>
</com.clockmods.pro.MonthGestureLayout>
