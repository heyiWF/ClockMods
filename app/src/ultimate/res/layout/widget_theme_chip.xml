<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme selector chip. A Material 3 filter chip behaves as a single-choice control inside a
  single-selection ChipGroup. The check icon is disabled so selecting a chip does not change
  its width, which keeps the strip from shifting under the user's finger.
-->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:minHeight="40dp"
    app:checkedIconVisible="false"
    app:chipMinHeight="40dp" />
