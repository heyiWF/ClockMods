<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ultimate_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ultimate_settings_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/ultimate_settings_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="179dp"
            android:fitsSystemWindows="true"
            app:collapsedTitleGravity="start|center_vertical"
            app:collapsedTitleTextAppearance="@style/UltimateSettings.CollapsingTitle.Collapsed"
            app:contentScrim="?attr/colorSurfaceVariant"
            app:expandedTitleGravity="start|bottom"
            app:expandedTitleMarginBottom="32dp"
            app:expandedTitleMarginEnd="24dp"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextAppearance="@style/UltimateSettings.CollapsingTitle.Expanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:maxLines="2"
            app:scrimAnimationDuration="50"
            app:scrimVisibleHeightTrigger="137dp"
            app:statusBarScrim="?attr/colorSurfaceVariant">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/ultimate_settings_toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <LinearLayout
            android:id="@+id/ultimate_settings_main_switch_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/ultimate_settings_page_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
