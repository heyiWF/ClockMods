<?xml version="1.0" encoding="utf-8"?>
<!--
  周程, portrait. A week is seven cells across the top and one card underneath: the strip says where
  you are, the card says what that day is. Only the strip pages — the card re-binds when the swipe
  commits, so its weather and 宜忌 are never asked to render a day the user has not landed on.
-->
<com.clockmods.pro.MonthGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_month_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/calendar_agenda_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/calendar_agenda_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/calendar_agenda_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:minWidth="48dp"
            android:minHeight="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/calendar_today"
            android:textSize="13sp" />

        <com.clockmods.ui.StatusBarView
            android:id="@+id/calendar_status_bar"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/calendar_agenda_strip_viewport"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="14dp"
        android:clipChildren="true">

        <LinearLayout
            android:id="@+id/calendar_agenda_strip_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/calendar_agenda_strip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal" />
    </FrameLayout>

    <include
        layout="@layout/calendar_agenda_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp" />
</com.clockmods.pro.MonthGestureLayout>
