<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/Theme.ClockMods.Widget.Dynamic">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg_instrument" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="@dimen/widget_inset_start" android:paddingEnd="@dimen/widget_inset_end" android:paddingTop="@dimen/widget_inset_top" android:paddingBottom="@dimen/widget_inset_bottom">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
                <TextClock android:id="@+id/widget_time" android:layout_marginEnd="0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="52sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="64sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="48dp" android:id="@+id/widget_weather_region" android:layout_weight="1" android:paddingEnd="@dimen/widget_top_line_end_extra">
                <LinearLayout android:id="@+id/widget_weather_reading" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/widget_weather_icon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@string/widget_weather_icon" />
                    <TextView android:id="@+id/widget_temperature" android:layout_weight="1" android:layout_width="0dp" android:layout_marginStart="@dimen/widget_icon_gap" android:layout_height="32dp" android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="—" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="28sp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_weather_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/widget_date" />
        <TextView android:id="@+id/widget_lunar" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_holiday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_weather_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:gravity="center_vertical" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:padding="14dp" android:src="@drawable/widget_settings" android:contentDescription="@string/widget_configure" />
</FrameLayout>
