<?xml version="1.0" encoding="utf-8"?>
<!--
  靛蓝周程, landscape. The seven-day strip becomes a vertical rail down the left and the detail card
  takes the wider right half, which is the shape landscape actually wants: a week reads fine as a
  list, and the card is where the extra width pays off.

  Every id here also appears in the portrait fork exactly once — AgendaCalendarLayout binds one set
  of views and reads the strip's orientation to decide which shape it built.
-->
<com.clockmods.pro.MonthGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_month_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="36"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calendar_agenda_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/calendar_agenda_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/calendar_agenda_strip_viewport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipChildren="true">

            <LinearLayout
                android:id="@+id/calendar_agenda_strip_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/calendar_agenda_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_weight="64"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/calendar_agenda_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:minWidth="48dp"
                android:minHeight="32dp"
                android:text="@string/calendar_today"
                android:textSize="13sp" />

            <com.clockmods.ui.StatusBarView
                android:id="@+id/calendar_status_bar"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <include
            layout="@layout/calendar_agenda_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</com.clockmods.pro.MonthGestureLayout>
