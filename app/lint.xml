<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
        The compat flavor targets API 1. All high-version calls are either
        wrapped in ApiCompat or guarded by Build.VERSION.SDK_INT checks.
        Legacy toolchains (build-tools 28) report several of these as errors
        even though the guarded code can never execute on an old device.
    -->
    <issue id="NewApi" severity="warning" />
    <issue id="InlinedApi" severity="warning" />
    <issue id="UnusedResources" severity="warning" />
    <issue id="OldTargetApi" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="ExpiredTargetSdkVersion" severity="ignore" />
    <issue id="RtlHardcoded" severity="ignore" />
    <issue id="ContentDescription" severity="ignore" />
    <issue id="HardcodedText" severity="ignore" />
</lint>
